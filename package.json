{
  "name": "barbapp",
  "version": "2.0.0",
  "private": true,
  "description": "Agendamento e gestão de barbearias com Next.js, React e TypeScript.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "db:init": "tsx --conditions=react-server scripts/database.ts",
    "db:seed": "tsx --conditions=react-server scripts/database.ts --seed",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
