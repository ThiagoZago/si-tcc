# Node.js 24+. SQLite local: preserve este diretório entre implantações.
DATABASE_PATH=./data/barbapp.sqlite
# URL canônica: origem aceita nas requisições que alteram dados; com https:// o cookie de sessão também é Secure.
APP_URL=http://localhost:3000
# Ative apenas em demonstrações locais; desative em um servidor público de produção.
ENABLE_DEMO=true
